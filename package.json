{
  "name": "taildesk",
  "version": "0.2.0",
  "description": "A standalone Windows VPN client for your existing Tailscale network.",
  "author": "rlukenbaugh",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "homepage": "https://github.com/rlukenbaugh/taildesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlukenbaugh/taildesk.git"
  },
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:live": "node scripts/smoke.mjs --live",
    "build": "node scripts/build.mjs",
    "dist:win": "npm run build && node scripts/verify-engine.mjs && electron-builder --win nsis --x64 --publish never",
    "build:engine": "node scripts/build-engine.mjs",
    "test:engine": "node scripts/engine-smoke.mjs"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "^26.8.1",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.rlukenbaugh.taildesk",
    "productName": "Taildesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Taildesk-Setup-${version}-${arch}.${ext}",
      "include": "installer/service.nsh",
      "runAfterFinish": false
    },
    "extraResources": [
      {
        "from": "engine-bin",
        "to": "engine",
        "filter": [
          "taildesk-cli.exe",
          "taildesk-engine.exe",
          "wintun.dll",
          "manifest.json",
          "licenses/**/*"
        ]
      },
      {
        "from": "installer/manage-service.ps1",
        "to": "engine/manage-service.ps1"
      }
    ]
  }
}
