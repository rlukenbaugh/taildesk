{
  "name": "taildesk",
  "version": "0.1.0",
  "description": "An independent Windows companion for your existing Tailscale service.",
  "author": "rlukenbaugh",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "homepage": "https://github.com/rlukenbaugh/taildesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlukenbaugh/taildesk.git"
  },
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:live": "node scripts/smoke.mjs --live",
    "build": "node scripts/build.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "^26.8.1",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.rlukenbaugh.taildesk",
    "productName": "Taildesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Taildesk-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Taildesk-Portable-${version}-${arch}.${ext}"
    }
  }
}
